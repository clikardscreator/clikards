# Copier ce fichier en .env.local (jamais commité) et renseigner les valeurs
# obtenues dans la console Google Cloud.

# Identifiant client OAuth (connexion « Se connecter avec Google » sur /compte).
# Voir docs/GOOGLE_SETUP.md.
VITE_GOOGLE_CLIENT_ID=

# Clé API Google restreinte (API Drive uniquement, domaine autorisé = votre
# déploiement GitHub Pages + localhost), utilisée pour lire un dossier Drive
# partagé par lien public (CLAUDE.md section 7, mode A). Indépendante de la
# connexion ci-dessus.
VITE_GOOGLE_API_KEY=
